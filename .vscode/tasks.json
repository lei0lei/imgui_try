{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake: Configure (dev SDL3 Vulkan)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S",
				"${workspaceFolder}/dev",
				"-B",
				"${workspaceFolder}/dev/build",
				"-G",
				"Visual Studio 17 2022",
				"-A",
				"x64",
				"-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
				"-DIMGUITRY_USE_VOLK=ON"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "CMake: Build (dev SDL3 Vulkan)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/dev/build",
				"--config",
				"Debug"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": "CMake: Configure (dev SDL3 Vulkan)"
		},
		{
			"label": "Run dev SDL3 Vulkan Example",
			"type": "shell",
			"command": "${workspaceFolder}/dev/build/Debug/Imgui_dev.exe",
			"problemMatcher": [],
			"dependsOn": "CMake: Build (dev SDL3 Vulkan)"
		},
		{
			"label": "Build and Run (dev SDL3 Vulkan)",
			"dependsOrder": "sequence",
			"dependsOn": [
				"CMake: Build (dev SDL3 Vulkan)",
				"Run dev SDL3 Vulkan Example"
			],
			"problemMatcher": []
		},
		{
			"label": "Run dev SDL3 Vulkan Example (manual)",
			"type": "shell",
			"command": "dev/build/Debug/Imgui_dev.exe",
			"group": "test"
		}
	]
}
