direction: right

input: "UI Inputs\n(title menu/buttons)"
title_service: "TitleBarService\nTriggerCommand + ConsumeLastCommand"
controller: "WorkbenchCommandController"
command_service: "CommandService\nmap<CommandId, Handler>"
handlers: "RegisterWorkbenchCommands\n(file/edit/view/help/window)"
services: "Domain Services\n(layout/editor/panel/notification/activity)"
result: "Updated UI state\nvisible next frame"

input -> title_service: "trigger CommandId"
title_service -> controller: "consume per frame"
controller -> command_service: "Execute(cmd)"
command_service -> handlers: "dispatch lambda"
handlers -> services: "apply state changes"
services -> result

file_group: "File Commands\nnew/open/save/exit"
view_group: "View Commands\ntoggle sidebars/panel"
window_group: "Window Commands\nmin/max/close"
help_group: "Help Commands\nabout"
edit_group: "Edit Commands\nundo/redo"

handlers -> file_group
handlers -> view_group
handlers -> window_group
handlers -> help_group
handlers -> edit_group
