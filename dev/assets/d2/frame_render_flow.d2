direction: down

start: "SDL Event Poll"
menu: "TitleBar UI\nset active menu / trigger command"
consume: "WorkbenchCommandController\nConsumeLastCommand"
execute: "CommandService.Execute(CommandId)"
state: "Services state updated"
new_frame: "ImGui NewFrame"
metrics: "Workbench.UpdateFrameStats + GetUiMetrics"
layout: "WorkbenchRenderer.ComputeLayout"
render_passes: "Render sequence\nActivity -> Title -> Status -> Sidebars -> Editor -> Panel"
imgui_render: "ImGui::Render"
vk_record: "FrameRender\nrecord cmd buffer"
vk_present: "FramePresent\nqueue present"
loop: "next frame"

start -> menu
menu -> consume
consume -> execute: "if cmd != None"
execute -> state
state -> new_frame
new_frame -> metrics
metrics -> layout
layout -> render_passes
render_passes -> imgui_render
imgui_render -> vk_record
vk_record -> vk_present
vk_present -> loop
loop -> start: "while !done"
