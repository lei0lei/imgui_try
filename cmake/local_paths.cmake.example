# Machine-local dependency paths (one copy per machine).
#
# Setup:
#   copy cmake\local_paths.cmake.example cmake\local_paths.cmake
#   Edit the paths below for your machine.
#
# Paths can still be overridden on the cmake command line, e.g.:
#   cmake -S templ -B templ/build -DSDL3_SOURCE_DIR=D:/src/SDL

# Paths use CACHE ... FORCE so edits here apply on the next cmake configure
# (without deleting the build directory). Command-line -D overrides are still
# possible if passed after this file is loaded — prefer editing this file.

set(SDL3_SOURCE_DIR "D:/path/to/SDL" CACHE PATH "Path to SDL3 source tree (contains CMakeLists.txt)" FORCE)
set(IMGUITRY_VOLK_SOURCE_DIR "D:/path/to/volk" CACHE PATH "Path to volk source tree (contains CMakeLists.txt)" FORCE)
set(LUA_SOURCE_DIR "D:/path/to/lua-5.5.0" CACHE PATH "Path to Lua source tree (contains CMakeLists.txt)" FORCE)
set(DOXYGEN_EXECUTABLE "C:/Program Files/doxygen/bin/doxygen.exe" CACHE FILEPATH "Path to Doxygen executable (optional)" FORCE)
