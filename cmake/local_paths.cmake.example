# Optional machine-local overrides (one copy per machine).
#
# Setup:
#   copy cmake\local_paths.cmake.example cmake\local_paths.cmake
#   Uncomment only the dependencies you want to use from a local checkout.
#
# Without these overrides, CMake downloads all dependencies from GitHub.
# The same values may be passed on the command line, for example:
#   cmake -S . -B build -DFETCHCONTENT_SOURCE_DIR_SDL3=D:/src/SDL

# set(FETCHCONTENT_SOURCE_DIR_SDL3 "D:/src/SDL" CACHE PATH "Local SDL3 checkout")
# set(FETCHCONTENT_SOURCE_DIR_VOLK "D:/src/volk" CACHE PATH "Local volk checkout")
# set(FETCHCONTENT_SOURCE_DIR_VK_BOOTSTRAP "D:/src/vk-bootstrap" CACHE PATH "Local vk-bootstrap checkout")

# Lua's override must use the layout of https://github.com/lua/lua
# (source files such as lapi.c are in the repository root).
# set(FETCHCONTENT_SOURCE_DIR_LUA "D:/src/lua" CACHE PATH "Local Lua checkout")

# set(DOXYGEN_EXECUTABLE "C:/Program Files/doxygen/bin/doxygen.exe"
#     CACHE FILEPATH "Path to Doxygen executable")
